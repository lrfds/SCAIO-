# ============================================
# SCAIO - Environment Variables
# ============================================

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=scaio_super_secret_key_2026

# WebSocket
WEBSOCKET_ENABLED=true

# ============================================
# Databases
# ============================================

# PostgreSQL (EventStore)
POSTGRES_URL=postgresql://scaio:scaio_pass@localhost:5432/scaio

# Qdrant (Vector Memory)
QDRANT_URL=http://localhost:6333

# Redis (Cache & Queues)
REDIS_URL=redis://localhost:6379

# Qdrant Collections
QDRANT_SEMANTIC_COLLECTION=semantic_memory
QDRANT_PROCEDURAL_COLLECTION=procedural_memory

# ============================================
# Quality Thresholds
# ============================================

# Limiar de Materialidade (analogia jurídica)
MIN_QUALITY_SCORE=7.0

# Auto-correção
MAX_RETRIES=3
MIN_SUCCESS_RATE=70.0

# ============================================
# Monitoring
# ============================================

HEALTH_CHECK_INTERVAL=60
MAX_SILENCE_MINUTES=30
CONSECUTIVE_FAILURES_THRESHOLD=3

# ============================================
# Alerting (WhatsApp)
# ============================================

WHATSAPP_ENABLED=false
WHATSAPP_COOLDOWN_MINUTES=60
WHATSAPP_RECIPIENTS=["+5511999999999"]

# Evolution API (WhatsApp Gateway)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your_evolution_api_key
EVOLUTION_INSTANCE=scaio_agent

# ============================================
# Agent Toggles
# ============================================

EDITAL_HUNTER_ENABLED=true
HEALTH_AGENT_ENABLED=true
META_HEALTH_ENABLED=true

# ============================================
# LLM Models
# ============================================

# Heavy model (Groq + Llama3)
LLM_MODEL_HEAVY=groq/llama-3-70b
GROQ_API_KEY=your_groq_api_key

# Light model (Ollama local)
LLM_MODEL_LIGHT=ollama/phi
OLLAMA_URL=http://localhost:11434

# ============================================
# Search Configuration
# ============================================

DEFAULT_SEARCH_DOMAINS=[".gov.br"]
DEFAULT_KEYWORDS=["edital", "chamamento público", "chamada pública"]

# ============================================
# Logging
# ============================================

LOG_LEVEL=INFO
LOG_FILE=/var/log/scaio/scaio.log
